# 阿里云百炼 · 通义万相（wanx2.1-imageedit）图片生成配置（仅服务端读取，切勿提交到 Git）

# 必填：阿里云百炼 API Key（https://bailian.console.aliyun.com 获取，形如 sk-xxx）
DASHSCOPE_API_KEY=

# 可选：百炼 API 地址，默认官方地址
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 可选：万相图像编辑模型，默认 wanx2.1-imageedit
WANX_MODEL=wanx2.1-imageedit

# 可选：风格化强度 0~1，默认 0.55（越小越接近原图，越大改动越明显）
WANX_STRENGTH=0.55
